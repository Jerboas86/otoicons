{
  "name": "otoicons",
  "version": "0.2.0",
  "description": "Audiometric symbols: ASHA 1990 and ISO 8253-3 speech audiometry, with one aided marking for both, in SVG and PNG",
  "keywords": [
    "ASHA",
    "ISO 8253-3",
    "audiogram",
    "audiology",
    "audiometry",
    "hearing aid",
    "speech audiometry",
    "svg",
    "symbols"
  ],
  "homepage": "https://github.com/Jerboas86/otoicons#readme",
  "bugs": {
    "url": "https://github.com/Jerboas86/otoicons/issues"
  },
  "license": "Apache-2.0",
  "author": "Benoit Delemps",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jerboas86/otoicons.git"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/otoicons.js",
  "module": "./dist/otoicons.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/otoicons.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "test:unit": "vitest run",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "oxfmt --check . && oxlint",
    "format": "oxfmt --write .",
    "doc": "pnpm build && node scripts/doc.mjs",
    "bundle": "pnpm doc && node scripts/bundle.mjs",
    "prepublishOnly": "pnpm build",
    "examples:standalone": "pnpm build && node examples/standalone.mjs",
    "analyze": "fallow"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "fallow": "^3.33.1",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "sharp": "0.35.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.28.2"
}
